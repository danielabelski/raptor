#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Build source inventory (checklist.json) for a target directory.

Usage: raptor-build-checklist <target> <output_dir>

Produces checklist.json with files, functions, globals, SLOC, and SHA-256
hashes. Always rehashes files on disk. Unchanged files reuse their old
parsed entries (including coverage marks); changed files are re-parsed
and their coverage marks cleared.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def main():
    # Use argparse so unknown --flags raise instead of silently
    # being filtered out. Pre-fix `[a for a in sys.argv[1:]
    # if not a.startswith('--')]` discarded EVERY --flag without
    # logging which ones got dropped. If an operator passed
    # `--out /custom` thinking it'd override the positional
    # output_dir, the flag was silently ignored and the
    # positional defaulted (or raised "Usage" if positional
    # was missing). Confusing failure mode — the operator's
    # explicit intent didn't take effect with no breadcrumb.
    import argparse
    ap = argparse.ArgumentParser(
        prog="raptor-build-checklist",
        description="Build a per-file checklist for exploitability validation.",
    )
    ap.add_argument("target", help="Target source root.")
    ap.add_argument("output_dir", help="Where to write the checklist.")
    ap.add_argument(
        "--scope", action="append", default=None,
        help="Restrict to these subdirectories (repeatable)",
    )
    # Tolerate well-known launcher flags that may be passed
    # through but aren't relevant here. parse_known_args puts
    # them in `_extras`; we don't act on them but document
    # their presence so future readers see why we accept them.
    parsed, _extras = ap.parse_known_args(sys.argv[1:])
    target = parsed.target
    output_dir = parsed.output_dir

    if not Path(target).exists():
        print(f"ERROR: target not found: {target}", file=sys.stderr)
        sys.exit(1)

    Path(output_dir).mkdir(parents=True, exist_ok=True)

    if _is_binary_target(Path(target)):
        checklist = _build_binary_checklist(Path(target), Path(output_dir))
        items = checklist.get("total_items", 0)
        stats = checklist.get("binary_stats", {})
        print(
            f"Binary checklist: {items} functions "
            f"({stats.get('named_functions', 0)} named, "
            f"source: {stats.get('source_tool', '?')})"
        )
        return

    from packages.exploitability_validation import build_checklist
    checklist = build_checklist(target, output_dir, scope=parsed.scope)

    total = checklist.get("total_files", 0)
    items = checklist.get("total_items", 0)
    sloc = checklist.get("total_sloc", 0)
    print(f"Checklist: {total} files, {items} items, {sloc} SLOC")


def _is_binary_target(target: Path) -> bool:
    """A compiled artifact (ELF/PE/Mach-O) or a Ghidra project."""
    if target.is_dir():
        return False
    if target.suffix == ".gpr":
        return True
    try:
        with open(target, "rb") as f:
            magic = f.read(4)
    except OSError:
        return False
    return magic in (
        b"\x7fELF",
        b"\xfe\xed\xfa\xce", b"\xfe\xed\xfa\xcf",
        b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe",
        # fat Mach-O
        b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca",
    ) or magic[:2] == b"MZ"


def _build_binary_checklist(target: Path, output_dir: Path) -> dict:
    """Binary route: REDatabase → build_binary_checklist.

    Reuses an re-database.json already in the output directory (a
    prior /ghidra import with --decompile-all is the recommended
    prep); otherwise imports fresh — Ghidra project targets through
    the sandboxed bridge, raw binaries through the r2/objdump
    fallback chain (reduced fidelity, no decompilation).
    """
    import json

    from core.audit.binary_context import find_redb, load_redb
    from core.inventory.binary_builder import build_binary_checklist

    db = None
    binary_path = target if target.suffix != ".gpr" else None
    redb_path = find_redb(output_dir, target)
    if redb_path is not None:
        db = load_redb(redb_path)
        # Identity check: a cached database stamped with a different
        # binary's hash must not be attested under this target.
        stamped = (db.metadata or {}).get("binary_sha256")
        if stamped and binary_path is not None:
            from core.hash import sha256_file
            actual = sha256_file(binary_path)
            if stamped != actual:
                print(
                    f"cached database at {redb_path} belongs to a "
                    "different binary — reimporting",
                    file=sys.stderr,
                )
                db = None
        if db is not None:
            print(f"using cached binary database: {redb_path}")
    if db is None and target.suffix == ".gpr":
        from packages.ghidra.bridge import GhidraBridge
        bridge = GhidraBridge(target)
        db = bridge.import_project(output_dir, decompile=True)
        bridge.close()
    elif db is None:
        from packages.ghidra.r2_import import r2_available
        if r2_available():
            print("importing via r2 (degraded: no decompiler types)",
                  file=sys.stderr)
            from packages.ghidra.r2_import import import_binary_r2
            db = import_binary_r2(target)
        else:
            print("importing via objdump/nm (degraded: symbols only)",
                  file=sys.stderr)
            from packages.ghidra.objdump_import import import_binary_objdump
            db = import_binary_objdump(target)
        with open(output_dir / "re-database.json", "w") as f:
            json.dump(db.to_dict(), f, indent=1)

    # A prior /understand --map of the binary enriches priority
    # scoring with entry-point and sink addresses.
    context_map = None
    for cand in (output_dir / "binary-context-map.json",
                 output_dir / "context-map.json",
                 output_dir.parent / "binary-context-map.json"):
        if cand.is_file():
            try:
                context_map = json.loads(cand.read_text())
                print(f"using context map: {cand}")
                break
            except (OSError, ValueError):
                continue

    checklist = build_binary_checklist(
        db,
        binary_path=binary_path,
        include_auto_named=True,
        context_map=context_map,
    )
    with open(output_dir / "checklist.json", "w") as f:
        json.dump(checklist, f, indent=2)
    return checklist


if __name__ == "__main__":
    main()
